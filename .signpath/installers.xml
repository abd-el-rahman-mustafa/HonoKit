<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="HonoPDF-Setup-*.exe"
             product-name="HonoPDF" product-version="${version}"
             company-name="HonoPDF contributors">
      <authenticode-sign />
    </pe-file>
    <pe-file path="HonoPDF-*-portable.exe"
             product-name="HonoPDF" product-version="${version}"
             company-name="HonoPDF contributors">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
