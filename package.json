{
  "name": "honokit",
  "productName": "HonoKit",
  "version": "0.20.3",
  "private": true,
  "description": "Every PDF and image tool, offline. Arabic and right-to-left first.",
  "author": "HonoKit contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/abd-el-rahman-mustafa/HonoKit",
  "repository": {
    "type": "git",
    "url": "https://github.com/abd-el-rahman-mustafa/HonoKit.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icon.mjs && node scripts/make-file-icons.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "check:edit": "npm run build && node scripts/editcheck.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.44",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.8.15",
    "asn1js": "^3.0.10",
    "bidi-js": "^1.0.3",
    "docx": "^9.8.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "hunspell-asm": "^4.0.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mupdf": "^1.28.1",
    "node-forge": "^1.4.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "upng-js": "^2.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^5.0.3",
    "clsx": "^2.1.1",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "zustand": "^5.0.8"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
